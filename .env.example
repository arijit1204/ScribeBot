# TubeRAG Environment Configuration Template

# Groq API Key (Required for LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (default: qwen/qwen3.8-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# Maximum response tokens (keep below your Groq organization output limit)
GROQ_MAX_TOKENS=900

# Embedding Model (HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage Directory for Vector Store & Transcripts
PERSIST_DIR=./data/chroma_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
